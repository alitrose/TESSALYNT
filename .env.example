# ==========================================
# TESSALYNT ENVIRONMENT CONFIGURATION
# ==========================================

# Google Gemini API Key
# Obtain your free API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_new_api_key

# Flask Application Settings
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# Server Port (Render sets this dynamically)
PORT=5000
